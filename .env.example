# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# PostgreSQL connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-strong-random-secret-here"

# Set to your Vercel domain after deploy, e.g. https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"
